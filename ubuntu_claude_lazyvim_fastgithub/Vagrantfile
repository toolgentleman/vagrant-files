# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "4096"
    vb.cpus = 2
  end

  config.vm.provision "file", 
    source: "./nvim-linux-x86_64.appimage", 
    destination: "/home/vagrant/nvim.appimage"

  config.vm.provision "file", 
    source: "./fastgithub", 
    destination: "/home/vagrant/fastgithub"

  config.vm.provision "shell", inline: <<-SHELL
    set -e 
    FASTGITHUB_DIR="/home/vagrant/fastgithub"
    PROXY="http://127.0.0.1:38457"
    BASHRC="/home/vagrant/.bashrc"

    apt-get update
    apt-get install -y fuse libfuse2 git curl gcc

    EXEC_PATH=/home/vagrant/fastgithub/fastgithub
    echo "Found fastgithub executable: $EXEC_PATH"
    chmod +x "$EXEC_PATH"
    chmod +x "/home/vagrant/fastgithub/dnscrypt-proxy/dnscrypt-proxy"
    sudo "$EXEC_PATH" start
    sleep 2
    systemctl status fastgithub || echo "fastgithub service may not be active, check logs."

    if ! grep -q "export http_proxy" "$BASHRC"; then
      echo "export http_proxy=$PROXY" >> "$BASHRC"
      echo "export https_proxy=$PROXY" >> "$BASHRC"
      echo "export all_proxy=$PROXY" >> "$BASHRC"
      echo "git config --global http.proxy $PROXY" >> "$BASHRC"
      echo "git config --global https.proxy $PROXY" >> "$BASHRC"
      echo "Proxy environment variables added to ~/.bashrc"
    else
      echo "Proxy already set in ~/.bashrc"
    fi

    curl -fsSL https://deb.nodesource.com/setup_lts.x | bash -
    apt-get install -y nodejs
    node --version
    npm --version
    npm config set registry https://registry.npmmirror.com

    npm install -g @anthropic-ai/claude-code
    claude --version || echo "Claude Code installed"

    chmod +x /home/vagrant/nvim.appimage
    ln -sf /home/vagrant/nvim.appimage /usr/local/bin/nvim

    npm install -g tree-sitter-cli

    sudo -u vagrant git clone https://github.com/LazyVim/starter /home/vagrant/.config/nvim
    sudo -u vagrant nvim --headless +'Lazy! sync' +qa

    echo "done"
  SHELL
end
