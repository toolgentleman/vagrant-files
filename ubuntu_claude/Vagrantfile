# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "4096"
    vb.cpus = 2
  end

  config.vm.provision "file", 
    source: "./nvim-linux-x86_64.appimage", 
    destination: "/home/vagrant/nvim.appimage"

  config.vm.provision "shell", inline: <<-SHELL
    set -e 
    
    apt-get update

    apt-get install -y fuse libfuse2
    chmod +x /home/vagrant/nvim.appimage
    ln -sf /home/vagrant/nvim.appimage /usr/local/bin/nvim

    curl -fsSL https://deb.nodesource.com/setup_lts.x | bash -
    apt-get install -y nodejs
    node --version
    npm --version
    npm config set registry https://registry.npmmirror.com

    npm install -g pnpm
    pnpm config set registry https://registry.npmmirror.com

    npm install -g @anthropic-ai/claude-code
    claude --version || echo "Claude Code installed"

    sudo -u vagrant git clone https://github.com/LazyVim/starter /home/vagrant/.config/nvim
    sudo -u vagrant nvim --headless +'Lazy! sync' +qa

    echo "done"
  SHELL
end
